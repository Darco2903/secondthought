{
    "name": "@darco2903/secondthought",
    "version": "1.4.1",
    "author": "Darco2903",
    "description": "Typed time units (ns to weeks) for TypeScript that prevent mixing up seconds, milliseconds and other units.",
    "keywords": [
        "time",
        "duration",
        "units",
        "typed",
        "typescript",
        "milliseconds",
        "seconds",
        "conversion",
        "type-safe"
    ],
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "sideEffects": false,
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@12.16.1",
    "homepage": "https://github.com/Darco2903/secondthought#readme",
    "bugs": {
        "url": "https://github.com/Darco2903/secondthought/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Darco2903/secondthought.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "rimraf dist && tsc",
        "check": "tsc --noEmit && tsc -p tests",
        "test": "vitest run",
        "test:ui": "vitest --ui",
        "prepack": "pnpm build",
        "clean": "rimraf -g dist darco2903-secondthought-*.tgz"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "@vitest/ui": "^5.0.5",
        "rimraf": "^6.1.3",
        "typescript": "^5.9.3",
        "vitest": "^5.0.5"
    }
}
